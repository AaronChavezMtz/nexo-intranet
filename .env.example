# Entorno: development | production
FLASK_ENV=development
FLASK_APP=run.py

# Clave secreta (obligatoria en producción). Genera una con:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Base de datos. En desarrollo se usa SQLite por defecto si se deja vacío.
# En producción, usar la cadena de conexión que entregue tu proveedor (PostgreSQL recomendado).
DATABASE_URL=
